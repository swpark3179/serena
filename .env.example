# Offline / in-house build configuration.
#
# Enable full offline mode: no usage reporting, no remote news, no web dashboard,
# and no automatic download/installation of language servers (manual install guidance
# is shown instead). Set to "false" (or unset) to restore the default online behavior.
SERENA_OFFLINE=true

# Explicitly disable anonymous usage statistics reporting.
# (Also implied by SERENA_OFFLINE=true.)
SERENA_USAGE_REPORTING=false

# Note: this build does not use any external LLM provider (the Anthropic dependency
# and Anthropic-based token counting have been removed), so no provider API keys are required.
